{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/daggerheart/ancestries.schema.json",
  "title": "Ancestries",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "description", "features"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "features": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "text"],
          "properties": {
            "name": { "type": "string" },
            "text": { "type": "string" }
          }
        }
      }
    }
  }
}
